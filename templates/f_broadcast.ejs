</div>
</div>
</div>
<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>

<!-- Logout Modal-->
<div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <a class="btn btn-primary" href="/logout">Logout</a>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap core JavaScript-->
<script src="/static/vendor/jquery/jquery.min.js"></script>
<script src="/static/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/static/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/static/js/sb-admin-2.min.js"></script>
<script src="/static/vendor/select2/select2.min.js"></script>
<script src="/static/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
<script src="/static/vendor/socket.io/socket.io.min.js"></script>
<script>
    var jumlahpenerima = 0;

    function closeBroadcastProgress() {
        $('#liveProgressContainer').slideUp();
        $('#globalBroadcastAlert').slideUp();
        sessionStorage.setItem('dismissed_broadcast', 'true');
        $.post('/broadcast/dismiss-progress');
    }

    function updateProgressUI(data) {
        if (!data) return;

        // If a new broadcast is running, clear any dismissed state
        if (data.running) {
            sessionStorage.removeItem('dismissed_broadcast');
        }

        // If broadcast is completed and user dismissed it or state reset, don't show
        if (!data.running && data.percentage === 100 && sessionStorage.getItem('dismissed_broadcast') === 'true') {
            return;
        }

        if (!data.running && (data.percentage === 0 || !data.kode)) {
            $('#globalBroadcastAlert').slideUp();
            $('#liveProgressContainer').slideUp();
            return;
        }
        
        // 1. Update Global Navbar Banner
        if (data.running || (data.percentage > 0 && data.percentage < 100)) {
            $('#globalBroadcastAlert').slideDown();
            $('#globalProgressKode').text(data.kode || '-');
            $('#globalProgressPercent').text(data.percentage + '%');
            $('#globalProgressBar').css('width', data.percentage + '%').text(data.percentage + '%');
            $('#globalProgressCount').text((data.current || 0) + '/' + (data.total || 0));
            $('#globalProgressSuccess').text((data.successCount || 0) + ' Terkirim');
            $('#globalProgressFailed').text((data.failedCount || 0) + ' Gagal');
            if (data.statusText) {
                $('#globalProgressStatusText').html(data.statusText);
            }
        } else if (data.percentage === 100 && !data.running) {
            $('#globalProgressStatusText').html(data.statusText || '🎉 Selesai!');
            $('#globalProgressBar').css('width', '100%').text('100%');
            setTimeout(function() {
                $('#globalBroadcastAlert').slideUp();
            }, 8000);
        }

        // 2. Update Local Detail Card (Broadcast Page)
        if (data.running || (data.percentage > 0 && sessionStorage.getItem('dismissed_broadcast') !== 'true')) {
            $('#liveProgressContainer').slideDown();
            $('#progressKode').text(data.kode || '-');
            $('#progressBar').css('width', data.percentage + '%').text(data.percentage + '%');
            $('#progressTotal').text(data.total || 0);
            $('#progressSuccess').text(data.successCount || 0);
            $('#progressFailed').text(data.failedCount || 0);
            var remaining = Math.max(0, (data.total || 0) - (data.current || 0));
            $('#progressRemaining').text(remaining);
            
            if (data.logs && data.logs.length > 0) {
                var logHtml = '';
                $.each(data.logs, function(idx, item) {
                    logHtml += '<div class="py-1 border-bottom border-secondary">' + item + '</div>';
                });
                $('#progressLogsList').html(logHtml);
            }

            if (!data.running && data.percentage === 100) {
                // Tampilan State Selesai (Tetap Tampil / Tidak di-hidden sampai di-close)
                $('#progressCardHeader').removeClass('bg-primary').addClass('bg-success');
                $('#progressHeaderTitle').html('<i class="fas fa-check-circle mr-2"></i> Broadcast Selesai: <span id="progressKode" class="badge badge-light ml-1 font-weight-bold">' + (data.kode || '-') + '</span>');
                $('#progressPercentBadge').removeClass('badge-light text-dark').addClass('badge-light text-success font-weight-bold').html('🎉 Selesai 100%');
                $('#progressBar').removeClass('progress-bar-striped progress-bar-animated bg-primary').addClass('bg-success').css('width', '100%').text('100%');
                $('#progressStatusText').removeClass('alert-secondary').addClass('alert-success text-success').html('<i class="fas fa-check-circle mr-2"></i> ' + (data.statusText || 'Pengiriman broadcast telah selesai seluruhnya!'));
            } else {
                // Tampilan State Berjalan
                $('#progressCardHeader').removeClass('bg-success').addClass('bg-primary');
                $('#progressHeaderTitle').html('<i class="fas fa-satellite-dish fa-spin mr-2"></i> Real-time Progress Broadcast: <span id="progressKode" class="badge badge-light ml-1 font-weight-bold">' + (data.kode || '-') + '</span>');
                $('#progressPercentBadge').text(data.percentage + '%');
                $('#progressBar').addClass('progress-bar-striped progress-bar-animated bg-success');
                if (data.statusText) {
                    $('#progressStatusText').removeClass('alert-success text-success').addClass('alert-secondary text-dark').html(data.statusText);
                }
            }
        }
    }

    $(document).ready(function () {
        // Socket.IO realtime connection
        var socket = io();
        socket.on('broadcast-progress', function (data) {
            updateProgressUI(data);
        });

        socket.on('broadcast-dismissed', function () {
            $('#liveProgressContainer').slideUp();
            $('#globalBroadcastAlert').slideUp();
        });

        // Check if there is an active/completed broadcast in memory
        $.ajax({
            type: 'GET',
            url: '/broadcast/active-progress',
            success: function (data) {
                if (data && (data.running || (data.percentage > 0 && sessionStorage.getItem('dismissed_broadcast') !== 'true'))) {
                    updateProgressUI(data);
                }
            }
        });

        $('#tgl_broadcast').datepicker({
            format: 'yyyy-mm-dd',
        });
        
        //------------------------------------------------------------------------------------
        getpenerima($("#kode_broadcast").val());
        getpenerimadua($("#kode_broadcast").val());
        //------------------------------------------------------------------------------------
        $("#kirimsekarang").click(function (e) {
            if($('#nama_broadcast').val()=='' || $('#tgl_broadcast').val()=='' || $('#isi_broadcast').val()==''){
                alert('Data tidak boleh kosong');
            } else {
                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Menyimpan...');
                $.ajax({
                    type: 'POST',
                    url: '/broadcast/kirim',
                    data: {
                        'kode': $("#kode_broadcast").val(),
                        'nama': $("#nama_broadcast").val(),
                        'tgl': $("#tgl_broadcast").val(),
                        'aksi': $("#aksi option:selected").val(),
                        'deskripsi': $("#isi_broadcast").val(),
                    },
                    success: function () {
                        window.location.href = "/broadcast";
                    },
                    error: function (xhr) {
                        alert('Gagal menyimpan broadcast: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Terjadi kesalahan server'));
                        $btn.prop('disabled', false).html('Simpan');
                    }
                });
            }
        });

        //------------------------------------------------------------------------------------
        $("#updatebtn").click(function (e) {
            if($('#nama_broadcast').val()=='' || $('#tgl_broadcast').val()=='' || $('#isi_broadcast').val()==''){
                alert('Data tidak boleh kosong');
            } else {
                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Mengupdate...');
                $.ajax({
                    type: 'POST',
                    url: '/broadcast/update',
                    data: {
                        'kode': $("#kode_broadcast").val(),
                        'nama': $("#nama_broadcast").val(),
                        'tgl': $("#tgl_broadcast").val(),
                        'aksi': $("#aksi option:selected").val(),
                        'deskripsi': $("#isi_broadcast").val(),
                    },
                    success: function () {
                        window.location.href = "/broadcast";
                    },
                    error: function (xhr) {
                        alert('Gagal mengupdate broadcast: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Terjadi kesalahan server'));
                        $btn.prop('disabled', false).html('Simpan');
                    }
                });
            }
        });

        //------------------------------------------------------------------------------------
        $("#tambah_penerima").click(function (e) {
            if(jumlahpenerima>=20){
                alert('maksimal '+jumlahpenerima+' Penerima');
            }else{
                if($("#nama").val()==''){
                    alert('Pilih kontak terlebih dahulu');
                }else{
                    $.ajax({
                    type: 'POST',
                    url: '/broadcast/add-penerima',
                    data: {
                        'nama': $("#nama").val(),
                        'telp': $("#telp").val(),
                        'kode': $("#kode_broadcast").val(),
                    },
                    success: function () {
                        $("#nama").val('');
                        $("#telp").val('');
                        $("#deskripsi").val('');
			            $("#cari_kontak").val(null).trigger('change');
                        getpenerima($("#kode_broadcast").val());
                    }
                });
                }
            }
            
        });

        //=================================================================================================
        $('#cari_kontak').select2({
            placeholder: 'Cari berdasarkan nama / No. RM',
            minimumInputLength: 4,
            ajax: {
                url: '/broadcast/get-data-kontak',
                dataType: 'json',
                theme: 'bootstrap4',
                delay: 250,
                processResults: function (data) {
                    return {
                        results: $.map(data, function (item) {
                            return {
                                id: item.id,
                                text: item.nama + " (" + item.no_rm + ")"
                            }

                        })
                    }
                },
                cache: true
            }
        });

        //=======================================================
        $('#cari_kontak').on('select2:select', function (e) {
            var kode = $(this).val();
            $.ajax({
                type: 'GET',
                url: '/broadcast/get-data-kontak/' + kode,
                success: function (data) {
                    return {
                        results: $.map(data, function (item) {
                            $("#nama").val(item.nama);
                            $("#telp").val(item.telp);
                            $("#deskripsi").val(item.deskripsi);
                        })
                    }
                }, complete: function () {
                }
            });
        });
    });
    function getpenerimadua(kode){
        $.ajax({
        type: 'GET',
        url: '/broadcast/get-penerima/'+kode,
        success: function (data) {
            var rows ='';
            var no=0;
            jumlahpenerima=0;
            $.each(data,function(key, value){
                jumlahpenerima+=1;
                no +=1;
                rows = rows + '<tr>';
                rows = rows + '<td class="text-center">' +no+'</td>';
                rows = rows + '<td class="text-center">' +value.penerima+'</td>';
                rows = rows + '<td class="text-center">'+value.telp+'</td>';
                rows = rows + '</tr>';
            });
            $('#tubuhnya_dua').html(rows);
        }, complete: function () {
        }
    });
    }
    function getpenerima(kode){
        $.ajax({
        type: 'GET',
        url: '/broadcast/get-penerima/'+kode,
        success: function (data) {
            var rows ='';
            var no=0;
            jumlahpenerima=0;
            $.each(data,function(key, value){
                jumlahpenerima+=1;
                no +=1;
                rows = rows + '<tr>';
                rows = rows + '<td class="text-center">' +no+'</td>';
                rows = rows + '<td class="text-center">' +value.penerima+'</td>';
                rows = rows + '<td class="text-center">'+value.telp+'</td>';
                rows = rows + '<td class="text-center"><button class="btn btn-danger btn-sm" type="button" onclick="hapuspenerima('+value.id+')"><i class="fas fa-trash"></i></button></td>';
                rows = rows + '</tr>';
            });
            $('#tubuhnya').html(rows);
        }, complete: function () {
        }
    });
    }

    function hapuspenerima(id){
        $.ajax({
            type: 'POST',
            url: '/broadcast/hapus-penerima',
            data: {
                'kode': id,
            },
            success: function () {
            getpenerima($("#kode_broadcast").val());
            }
        });
    }

</script>
</body>

</html>