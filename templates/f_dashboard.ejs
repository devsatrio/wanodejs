</div>
</div>
</div>
<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>
<div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <a class="btn btn-primary" href="/logout">Logout</a>
            </div>
        </div>
    </div>
</div>
<script src="/static/vendor/jquery/jquery.min.js"></script>
<script src="/static/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/static/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/static/js/sb-admin-2.min.js"></script>
<script src="/static/vendor/select2/select2.min.js"></script>
<script src="/static/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
<script src="/static/vendor/socket.io/socket.io.min.js"></script>
<script>
    function closeBroadcastProgress() {
        $('#globalBroadcastAlert').slideUp();
        sessionStorage.setItem('dismissed_broadcast', 'true');
        $.post('/broadcast/dismiss-progress');
    }

    function updateWaStatusUI(statusMsg, qrSrc) {
        if (statusMsg) {
            $('#statusAlertText').html(statusMsg);
            if (statusMsg.includes('Ready') || statusMsg.includes('Terhubung')) {
                $('#statusAlertText').removeClass('alert-secondary alert-warning alert-info').addClass('alert-success text-success');
                $('#waStatusBadge').removeClass('badge-secondary badge-warning badge-danger').addClass('badge-success').html('<i class="fas fa-check-circle mr-1"></i> Terhubung');
            } else if (statusMsg.includes('QR Code') || statusMsg.includes('scan') || statusMsg.includes('Scan')) {
                $('#statusAlertText').removeClass('alert-secondary alert-success alert-danger').addClass('alert-warning text-dark');
                $('#waStatusBadge').removeClass('badge-secondary badge-success badge-danger').addClass('badge-warning').html('<i class="fas fa-qrcode mr-1"></i> Menunggu Scan QR');
            } else if (statusMsg.includes('Gagal') || statusMsg.includes('Terputus')) {
                $('#statusAlertText').removeClass('alert-secondary alert-success alert-warning').addClass('alert-danger text-danger');
                $('#waStatusBadge').removeClass('badge-secondary badge-success badge-warning').addClass('badge-danger').html('<i class="fas fa-exclamation-circle mr-1"></i> Terputus');
            } else {
                $('#statusAlertText').removeClass('alert-success alert-danger alert-warning').addClass('alert-secondary text-dark');
                $('#waStatusBadge').removeClass('badge-success badge-danger badge-warning').addClass('badge-secondary').html('<i class="fas fa-spinner fa-spin mr-1"></i> Memproses...');
            }
        }

        if (qrSrc) {
            if (qrSrc.startsWith('data:image')) {
                // Tampilan QR Code untuk discan
                $('#qrLoadingSpinner').hide();
                $('#waConnectedState').hide();
                $('#imgqr').attr('src', qrSrc).fadeIn();
            } else if (qrSrc.includes('img.jpg')) {
                // Tampilan State Terhubung
                $('#qrLoadingSpinner').hide();
                $('#imgqr').hide();
                $('#waConnectedState').fadeIn();
            }
        }
    }

    function reloadQrCode(force) {
        var $icon = $('#iconReloadQr');
        var $btn = $('#btnReloadQr');
        $icon.addClass('fa-spin');
        $btn.prop('disabled', true);

        $('#imgqr').hide();
        $('#waConnectedState').hide();
        $('#qrLoadingSpinner').show();
        $('#statusAlertText').html('<i class="fas fa-spinner fa-spin mr-1"></i> Meminta QR Code baru dari server...');

        $.ajax({
            type: 'POST',
            url: '/wa/reload-qr',
            data: { force: force || false },
            success: function(response) {
                if (response.isReady) {
                    $('#qrLoadingSpinner').hide();
                    $('#waConnectedState').fadeIn();
                }
            },
            error: function(xhr) {
                alert('Gagal memuat ulang QR Code: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Terjadi kesalahan server'));
                $('#qrLoadingSpinner').hide();
            },
            complete: function() {
                setTimeout(function() {
                    $icon.removeClass('fa-spin');
                    $btn.prop('disabled', false);
                }, 1000);
            }
        });
    }

    function logoutWaSession() {
        if (!confirm('Apakah Anda yakin ingin logout sesi WhatsApp ini untuk mengganti dengan nomor baru?')) {
            return;
        }

        var $btn = $('#btnLogoutWa');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Memutuskan...');
        $('#imgqr').hide();
        $('#waConnectedState').hide();
        $('#qrLoadingSpinner').show();
        $('#statusAlertText').html('<i class="fas fa-spinner fa-spin mr-1"></i> Memutus sesi WhatsApp lama & memuat QR baru...');

        $.ajax({
            type: 'POST',
            url: '/wa/logout-session',
            success: function(res) {
                // socket akan otomatis mengirim qr baru
            },
            error: function(xhr) {
                alert('Gagal logout sesi: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Terjadi kesalahan'));
            },
            complete: function() {
                $btn.prop('disabled', false).html('<i class="fas fa-sign-out-alt mr-1"></i> Ganti Nomor / Logout WA');
            }
        });
    }

    function getWaCon() {
        var socket = io();
        socket.on('connect', function() {
            console.log('Connected to WebSocket server');
        });
        socket.on('msg', function(msg) {
            updateWaStatusUI(msg, null);
        });
        socket.on('qr', function(src) {
            updateWaStatusUI(null, src);
        });
        socket.on('broadcast-progress', function (data) {
            if (!data) return;
            if (data.running) {
                sessionStorage.removeItem('dismissed_broadcast');
            }
            if (!data.running && data.percentage === 100 && sessionStorage.getItem('dismissed_broadcast') === 'true') {
                return;
            }
            if (data.running || (data.percentage > 0 && data.percentage < 100)) {
                $('#globalBroadcastAlert').slideDown();
                $('#globalProgressKode').text(data.kode || '-');
                $('#globalProgressPercent').text(data.percentage + '%');
                $('#globalProgressBar').css('width', data.percentage + '%').text(data.percentage + '%');
                $('#globalProgressCount').text((data.current || 0) + '/' + (data.total || 0));
                $('#globalProgressSuccess').text((data.successCount || 0) + ' Terkirim');
                $('#globalProgressFailed').text((data.failedCount || 0) + ' Gagal');
                if (data.statusText) {
                    $('#globalProgressStatusText').html(data.statusText);
                }
            } else if (data && data.percentage === 100 && !data.running) {
                if (sessionStorage.getItem('dismissed_broadcast') !== 'true') {
                    $('#globalBroadcastAlert').slideDown();
                    $('#globalProgressStatusText').html(data.statusText || '🎉 Selesai!');
                    $('#globalProgressBar').css('width', '100%').text('100%');
                    setTimeout(function() {
                        $('#globalBroadcastAlert').slideUp();
                    }, 8000);
                }
            }
        });
        socket.on('broadcast-dismissed', function () {
            $('#globalBroadcastAlert').slideUp();
        });
    }

    $(document).ready(function () {
        getWaCon();

        // 1. Cek status awal WhatsApp langsung dari API
        $.ajax({
            type: 'GET',
            url: '/wa/status-qr',
            success: function(data) {
                if (data) {
                    updateWaStatusUI(data.status, data.qr);
                }
            }
        });

        // 2. Cek status broadcast aktif
        $.ajax({
            type: 'GET',
            url: '/broadcast/active-progress',
            success: function (data) {
                if (data && (data.running || (data.percentage > 0 && data.percentage < 100 && sessionStorage.getItem('dismissed_broadcast') !== 'true'))) {
                    $('#globalBroadcastAlert').slideDown();
                    $('#globalProgressKode').text(data.kode || '-');
                    $('#globalProgressPercent').text(data.percentage + '%');
                    $('#globalProgressBar').css('width', data.percentage + '%').text(data.percentage + '%');
                    $('#globalProgressCount').text((data.current || 0) + '/' + (data.total || 0));
                    $('#globalProgressSuccess').text((data.successCount || 0) + ' Terkirim');
                    $('#globalProgressFailed').text((data.failedCount || 0) + ' Gagal');
                }
            }
        });

        // 3. Muat statistik angka dashboard
        $.ajax({
            type: 'GET',
            url: '/home/getdata',
            success: function (data) {
                $("#jumlahadmin").html(data.users);
                $("#pendingbroadcast").html(data.broadcast_pending);
                $("#broadcast").html(data.broadcast);
                $("#contact").html(data.contact);
            }
        });
    });
</script>
</body>

</html>