<%- include('../templates/h'); %>
    <%- include('../templates/n'); %>
        <div class="container-fluid">
            <h1 class="h3 mb-2 text-gray-800">Broadcast</h1>

            <!-- Live Broadcast Progress Card -->
            <div id="liveProgressContainer" style="display: none;" class="mb-4">
                <div class="card shadow border-left-primary">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center" id="progressCardHeader">
                        <h6 class="m-0 font-weight-bold" id="progressHeaderTitle"><i class="fas fa-satellite-dish mr-2" id="progressHeaderIcon"></i> Real-time Progress Broadcast: <span id="progressKode" class="badge badge-light ml-1 font-weight-bold">-</span></h6>
                        <div>
                            <span class="badge badge-light px-3 py-2 font-weight-bold mr-2" id="progressPercentBadge" style="font-size: 14px;">0%</span>
                            <button type="button" class="btn btn-sm btn-outline-light" onclick="closeBroadcastProgress()" title="Tutup Notifikasi"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 22px; border-radius: 10px;">
                            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success font-weight-bold" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                        </div>
                        <div class="row text-center mb-3">
                            <div class="col-3">
                                <span class="text-muted small">Total Penerima</span>
                                <h5 class="font-weight-bold text-dark" id="progressTotal">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-success">Berhasil Terkirim</span>
                                <h5 class="font-weight-bold text-success" id="progressSuccess">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-danger">Gagal / Skip</span>
                                <h5 class="font-weight-bold text-danger" id="progressFailed">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-warning">Sisa Antrean</span>
                                <h5 class="font-weight-bold text-warning" id="progressRemaining">0</h5>
                            </div>
                        </div>
                        <div class="alert alert-secondary py-2 px-3 mb-2 font-weight-bold text-dark" id="progressStatusText">
                            <i class="fas fa-spinner fa-spin mr-2"></i> Menyiapkan pengiriman...
                        </div>
                        <div class="mt-2">
                            <a class="small text-primary font-weight-bold" data-toggle="collapse" href="#collapseLogs" role="button" aria-expanded="false">
                                <i class="fas fa-list-alt mr-1"></i> Lihat Live Log Pengiriman (Detail)
                            </a>
                            <div class="collapse mt-2" id="collapseLogs">
                                <div class="card card-body bg-dark text-light p-2 font-monospace" id="progressLogsList" style="max-height: 160px; overflow-y: auto; font-size: 13px;">
                                    <div>Menunggu log pengiriman...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-white border-bottom d-flex flex-wrap align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-envelope mr-1"></i> List Data Broadcast
                    </h6>
                    <a href="/broadcast/add" class="btn btn-success btn-sm font-weight-bold shadow-sm">
                        <i class="fas fa-plus mr-1"></i> Buat Broadcast Baru
                    </a>
                </div>

                <!-- Filter & Pencarian Bar -->
                <div class="card-body bg-light border-bottom py-3">
                    <form action="/broadcast" method="GET" class="form-row align-items-end" id="filterBroadcastForm">
                        <!-- Search Keyword -->
                        <div class="col-lg-3 col-md-6 mb-2">
                            <label class="small font-weight-bold text-dark mb-1">
                                <i class="fas fa-search text-muted mr-1"></i> Kata Kunci
                            </label>
                            <input type="text" class="form-control form-control-sm" name="search" placeholder="Nama Broadcast / Kode..." value="<%= (typeof filter !== 'undefined' && filter) ? filter.search : '' %>">
                        </div>

                        <!-- Tgl Kirim Awal -->
                        <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                            <label class="small font-weight-bold text-dark mb-1">
                                <i class="fas fa-calendar-alt text-muted mr-1"></i> Tgl Kirim Dari
                            </label>
                            <input type="date" class="form-control form-control-sm" name="tgl_awal" value="<%= (typeof filter !== 'undefined' && filter) ? filter.tgl_awal : '' %>">
                        </div>

                        <!-- Tgl Kirim Akhir -->
                        <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                            <label class="small font-weight-bold text-dark mb-1">
                                <i class="fas fa-calendar-alt text-muted mr-1"></i> Sampai Tgl
                            </label>
                            <input type="date" class="form-control form-control-sm" name="tgl_akhir" value="<%= (typeof filter !== 'undefined' && filter) ? filter.tgl_akhir : '' %>">
                        </div>

                        <!-- Status Filter -->
                        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                            <label class="small font-weight-bold text-dark mb-1">
                                <i class="fas fa-filter text-muted mr-1"></i> Status
                            </label>
                            <select name="status" class="form-control form-control-sm">
                                <option value="">-- Semua Status --</option>
                                <option value="terkirim" <%= (typeof filter !== 'undefined' && filter && filter.status === 'terkirim') ? 'selected' : '' %>>Terkirim</option>
                                <option value="disimpan" <%= (typeof filter !== 'undefined' && filter && filter.status === 'disimpan') ? 'selected' : '' %>>Disimpan (Pending)</option>
                            </select>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-lg-3 col-md-8 col-sm-6 mb-2 d-flex">
                            <button type="submit" class="btn btn-sm btn-primary font-weight-bold mr-1 flex-grow-1 shadow-sm">
                                <i class="fas fa-filter mr-1"></i> Filter
                            </button>
                            <a href="/broadcast" class="btn btn-sm btn-outline-secondary font-weight-bold shadow-sm" title="Reset Filter">
                                <i class="fas fa-undo mr-1"></i> Reset
                            </a>
                        </div>
                    </form>

                    <!-- Active Filter Badges -->
                    <% 
                        var hasFilter = (typeof filter !== 'undefined' && filter) && (filter.search || filter.status || filter.tgl_awal || filter.tgl_akhir);
                        if (hasFilter) { 
                    %>
                        <div class="mt-2 pt-2 border-top d-flex align-items-center flex-wrap small">
                            <span class="text-muted mr-2 font-weight-bold"><i class="fas fa-info-circle mr-1"></i> Filter Aktif:</span>
                            <% if (filter.search) { %>
                                <span class="badge badge-primary mr-2 mb-1 py-1 px-2">Cari: "<%= filter.search %>"</span>
                            <% } %>
                            <% if (filter.tgl_awal && filter.tgl_akhir) { %>
                                <span class="badge badge-info mr-2 mb-1 py-1 px-2">Tgl: <%= filter.tgl_awal %> s/d <%= filter.tgl_akhir %></span>
                            <% } else if (filter.tgl_awal) { %>
                                <span class="badge badge-info mr-2 mb-1 py-1 px-2">Tgl &gt;= <%= filter.tgl_awal %></span>
                            <% } else if (filter.tgl_akhir) { %>
                                <span class="badge badge-info mr-2 mb-1 py-1 px-2">Tgl &lt;= <%= filter.tgl_akhir %></span>
                            <% } %>
                            <% if (filter.status) { %>
                                <span class="badge badge-<%= filter.status === 'terkirim' ? 'success' : 'secondary' %> mr-2 mb-1 py-1 px-2">Status: <%= filter.status === 'terkirim' ? 'Terkirim' : 'Disimpan' %></span>
                            <% } %>
                            <a href="/broadcast" class="text-danger ml-auto font-weight-bold">
                                <i class="fas fa-times-circle mr-1"></i> Hapus Filter
                            </a>
                        </div>
                    <% } %>
                </div>

                <div class="card-body">
                    <% if (messages.info) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-check-circle mr-1"></i> <%= messages.info %>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    <% } %>
                    <% if (messages.infoerror) { %>
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-exclamation-triangle mr-1"></i> <%= messages.infoerror %>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    <% } %>
                    <% 
                        var currentOffset = (typeof offset !== 'undefined') ? offset : 0;
                        var listProducts = (typeof products !== 'undefined' && products) ? products : [];
                        var totalData = (typeof total_data !== 'undefined') ? total_data : listProducts.length;
                        var totalPages = (typeof total_pages !== 'undefined') ? total_pages : 1;
                        var pageNumber = (typeof page_number !== 'undefined') ? page_number : 1;
                        var qStr = (typeof queryString !== 'undefined') ? queryString : '';
                    %>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="dataTableContact" width="100%" cellspacing="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">No</th>
                                        <th style="width: 110px;">Kode</th>
                                        <th>Nama Broadcast</th>
                                        <th style="width: 140px;">Pembuat</th>
                                        <th style="width: 120px;">Tgl Kirim</th>
                                        <th style="width: 110px;" class="text-center">Status</th>
                                        <th style="width: 130px;" class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!listProducts || listProducts.length === 0) { %>
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">
                                                <i class="fas fa-folder-open fa-2x mb-2 d-block text-gray-400"></i>
                                                Tidak ada data broadcast yang sesuai dengan kriteria filter.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% var number = currentOffset + 1; %>
                                        <% listProducts.forEach(function(row) { %>
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <%= number %>
                                                </td>
                                                <td class="align-middle font-weight-bold text-primary">
                                                    <%= row.kode %>
                                                </td>
                                                <td class="align-middle">
                                                    <%= row.nama || '-' %>
                                                </td>
                                                <td class="align-middle">
                                                    <%= row.namauser || '-' %>
                                                </td>
                                                <td class="align-middle">
                                                    <% 
                                                    var dateString = '-';
                                                    if (row.tgl_kirim) {
                                                        var d = new Date(row.tgl_kirim);
                                                        if (!isNaN(d.getTime())) {
                                                            dateString = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().split("T")[0];
                                                        }
                                                    }
                                                    %>
                                                    <%= dateString %>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <% if (row.status === 'terkirim') { %>
                                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> Terkirim</span>
                                                    <% } else if (row.status === 'disimpan') { %>
                                                        <span class="badge badge-secondary px-2 py-1"><i class="fas fa-save mr-1"></i> Disimpan</span>
                                                    <% } else { %>
                                                        <span class="badge badge-warning px-2 py-1"><%= row.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <a href="/broadcast/show/<%= row.kode %>"
                                                        class="btn btn-sm btn-info" title="Detail"><i
                                                            class="fa fa-eye"></i></a>
                                                    <a href="/broadcast/edit/<%= row.kode %>"
                                                        class="btn btn-sm btn-success" title="Edit"><i
                                                            class="fa fa-wrench"></i></a>
                                                    <a href="/broadcast/<%= row.kode %>/hapus"
                                                        onclick="return confirm('Apakah Anda yakin ingin menghapus data broadcast ini?')"
                                                        class="btn btn-sm btn-danger" title="Hapus"><i
                                                            class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>
                                            <% number++; %>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top">
                            <div class="text-muted small mb-2 mb-md-0">
                                Menampilkan <strong><%= listProducts.length > 0 ? currentOffset + 1 : 0 %></strong> - <strong><%= Math.min(currentOffset + listProducts.length, totalData) %></strong> dari <strong><%= totalData %></strong> data
                                <% if (totalPages > 1) { %>
                                    (Halaman <strong><%= pageNumber %></strong> dari <strong><%= totalPages %></strong>)
                                <% } %>
                            </div>

                            <% if (totalPages > 1) { %>
                                <nav aria-label="Broadcast Page Navigation">
                                    <ul class="pagination pagination-sm mb-0">
                                        <!-- First -->
                                        <li class="page-item <%= pageNumber <= 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="/broadcast?page=1<%= qStr %>" title="Halaman Pertama">
                                                <i class="fas fa-angle-double-left"></i>
                                            </a>
                                        </li>

                                        <!-- Prev -->
                                        <li class="page-item <%= pageNumber <= 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="/broadcast?page=<%= pageNumber - 1 %><%= qStr %>" title="Sebelumnya">
                                                <i class="fas fa-angle-left"></i>
                                            </a>
                                        </li>

                                        <!-- Numbered Pages with Ellipsis -->
                                        <% 
                                            var startPage = Math.max(1, pageNumber - 2);
                                            var endPage = Math.min(totalPages, pageNumber + 2);

                                            if (startPage > 1) { %>
                                                <li class="page-item"><a class="page-link" href="/broadcast?page=1<%= qStr %>">1</a></li>
                                                <% if (startPage > 2) { %>
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                <% } %>
                                            <% } %>

                                        <% for (var i = startPage; i <= endPage; i++) { %>
                                            <li class="page-item <%= pageNumber === i ? 'active' : '' %>">
                                                <a class="page-link" href="/broadcast?page=<%= i %><%= qStr %>"><%= i %></a>
                                            </li>
                                        <% } %>

                                        <% if (endPage < totalPages) { %>
                                            <% if (endPage < totalPages - 1) { %>
                                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                            <% } %>
                                            <li class="page-item"><a class="page-link" href="/broadcast?page=<%= totalPages %><%= qStr %>"><%= totalPages %></a></li>
                                        <% } %>

                                        <!-- Next -->
                                        <li class="page-item <%= pageNumber >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="/broadcast?page=<%= pageNumber + 1 %><%= qStr %>" title="Selanjutnya">
                                                <i class="fas fa-angle-right"></i>
                                            </a>
                                        </li>

                                        <!-- Last -->
                                        <li class="page-item <%= pageNumber >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="/broadcast?page=<%= totalPages %><%= qStr %>" title="Halaman Terakhir">
                                                <i class="fas fa-angle-double-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            <% } %>
                        </div>
                </div>
            </div>

        </div>
        <%- include('../templates/f_broadcast'); %>