<%- include('../templates/h'); %>
    <%- include('../templates/n'); %>
        <div class="container-fluid">
            <h1 class="h3 mb-2 text-gray-800">Broadcast</h1>

            <!-- Live Broadcast Progress Card -->
            <div id="liveProgressContainer" style="display: none;" class="mb-4">
                <div class="card shadow border-left-primary">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center" id="progressCardHeader">
                        <h6 class="m-0 font-weight-bold" id="progressHeaderTitle"><i class="fas fa-satellite-dish mr-2" id="progressHeaderIcon"></i> Real-time Progress Broadcast: <span id="progressKode" class="badge badge-light ml-1 font-weight-bold">-</span></h6>
                        <div>
                            <span class="badge badge-light px-3 py-2 font-weight-bold mr-2" id="progressPercentBadge" style="font-size: 14px;">0%</span>
                            <button type="button" class="btn btn-sm btn-outline-light" onclick="closeBroadcastProgress()" title="Tutup Notifikasi"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 22px; border-radius: 10px;">
                            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success font-weight-bold" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                        </div>
                        <div class="row text-center mb-3">
                            <div class="col-3">
                                <span class="text-muted small">Total Penerima</span>
                                <h5 class="font-weight-bold text-dark" id="progressTotal">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-success">Berhasil Terkirim</span>
                                <h5 class="font-weight-bold text-success" id="progressSuccess">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-danger">Gagal / Skip</span>
                                <h5 class="font-weight-bold text-danger" id="progressFailed">0</h5>
                            </div>
                            <div class="col-3">
                                <span class="text-muted small text-warning">Sisa Antrean</span>
                                <h5 class="font-weight-bold text-warning" id="progressRemaining">0</h5>
                            </div>
                        </div>
                        <div class="alert alert-secondary py-2 px-3 mb-2 font-weight-bold text-dark" id="progressStatusText">
                            <i class="fas fa-spinner fa-spin mr-2"></i> Menyiapkan pengiriman...
                        </div>
                        <div class="mt-2">
                            <a class="small text-primary font-weight-bold" data-toggle="collapse" href="#collapseLogs" role="button" aria-expanded="false">
                                <i class="fas fa-list-alt mr-1"></i> Lihat Live Log Pengiriman (Detail)
                            </a>
                            <div class="collapse mt-2" id="collapseLogs">
                                <div class="card card-body bg-dark text-light p-2 font-monospace" id="progressLogsList" style="max-height: 160px; overflow-y: auto; font-size: 13px;">
                                    <div>Menunggu log pengiriman...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Detail Data Broadcast</h6>
                </div>
                <% data.forEach(function(row) { %>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card shadow mb-4">
                                <div
                                    class="card-header bg-success py-3 d-flex flex-row align-items-center justify-content-between">
                                    <h6 class="m-0 font-weight-bold text-white">Detail</h6>
                                </div>
                                <div class="card-body">
                                    <input type="hidden" name="kode_broadcast" id="kode_broadcast" value="<%= row.kode %>" readonly>
                                    <table>
                                        <tr>
                                            <td>Kode</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td><%= row.kode %></td>
                                        </tr>
                                        <tr>
                                            <td>Nama Broadcat</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td><%= row.nama %></td>
                                        </tr>
                                        <tr>
                                            <td>Tanggal Buat</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td>
                                                <% 
                                                var date = row.tgl_buat;
                                                var dateString = new Date(date.getTime() - (date.getTimezoneOffset() * 60000 )).toISOString().split("T")[0];
                                                %>
                                                <%= dateString %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Tanggal Kirim</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td>
                                                <% 
                                                var datedua = row.tgl_kirim;
                                                var dateStringdua = new Date(datedua.getTime() - (datedua.getTimezoneOffset() * 60000 )).toISOString().split("T")[0];
                                                %>
                                                <%= dateStringdua %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Status</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td>
                                                <%= row.status %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Pembuat</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td>
                                                <%= row.namauser %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Isi</td>
                                            <td>&nbsp;:&nbsp;</td>
                                            <td>
                                                <%= row.isi %>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow mb-4">
                                <div
                                    class="card-header bg-info py-3 d-flex flex-row align-items-center justify-content-between">
                                    <h6 class="m-0 font-weight-bold text-white">Daftar Penerima Pesan</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="text-center">No</th>
                                                <th scope="col" class="text-center">Nama</th>
                                                <th scope="col" class="text-center">Nomor Telp</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tubuhnya_dua">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <%if (level==='Super Admin' ) { %>
                        <%if ( row.status === 'disimpan') { %>
                            <a href="/broadcast/kirim-broadcast/<%= row.kode %>" class="btn btn-primary">Kirim Sekarang</a>
                        <% }else{ %>
                            <a href="/broadcast/kirim-broadcast/<%= row.kode %>" class="btn btn-warning">Kirim Ulang</a>
                        <% } %>
                    <% } %>
                    <button type="button" onclick="history.go(-1)" class="btn btn-danger float-right">Kembali</button>
                </div>
                <% }); %>
            </div>
        </div>
        <%- include('../templates/f_broadcast'); %>