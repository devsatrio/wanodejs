<%- include('../templates/h'); %>
<%- include('../templates/n'); %>
<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">Broadcast</h1>
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">List Data Broadcast</h6>
            
            <div class="dropdown no-arrow">
                <form class="form-inline" action="/broadcast/search" method="GET">
                    <div class="form-group mx-sm-3 mb-2">
                      <label class="sr-only">Cari</label>
                      <input type="text" class="form-control" placeholder="Nama Broadcast / Kode" name="search" value="<%= pencarian || '' %>" required>
                    </div>
                    <button type="submit" class="btn btn-primary mb-2"><i class="fas fa-search"></i> Cari</button>
                    <a href="/broadcast/add" class="ml-2">
                        <button type="button" class="btn btn-success mb-2"><i class="fas fa-plus"></i> Add</button>
                    </a>
                  </form>
            </div>
        </div>
        <div class="card-body">
            <%if (messages.info) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= messages.info %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            <div class="table-responsive">
                <p class="mb-3">Hasil pencarian untuk "<b><%= pencarian %></b>" (<%= data ? data.length : 0 %> data ditemukan):</p>
                <table class="table table-bordered table-hover" id="dataTableContact" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">No</th>
                            <th style="width: 110px;">Kode</th>
                            <th>Nama Broadcast</th>
                            <th style="width: 140px;">Pembuat</th>
                            <th style="width: 120px;">Tgl Kirim</th>
                            <th style="width: 110px;" class="text-center">Status</th>
                            <th style="width: 130px;" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!data || data.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-search fa-2x mb-2 d-block text-gray-400"></i>
                                    Tidak ada data broadcast yang cocok dengan kata kunci "<b><%= pencarian %></b>".
                                </td>
                            </tr>
                        <% } else { %>
                            <% var number = 1; %>
                            <% data.forEach(function(row) { %>
                                <tr>
                                    <td class="text-center align-middle">
                                        <%= number %>
                                    </td>
                                    <td class="align-middle font-weight-bold text-primary">
                                        <%= row.kode %>
                                    </td>
                                    <td class="align-middle">
                                        <%= row.nama || '-' %>
                                    </td>
                                    <td class="align-middle">
                                        <%= row.namauser || '-' %>
                                    </td>
                                    <td class="align-middle">
                                        <% 
                                        var dateString = '-';
                                        if (row.tgl_kirim) {
                                            var d = new Date(row.tgl_kirim);
                                            if (!isNaN(d.getTime())) {
                                                dateString = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().split("T")[0];
                                            }
                                        }
                                        %>
                                        <%= dateString %>
                                    </td>
                                    <td class="text-center align-middle">
                                        <% if (row.status === 'terkirim') { %>
                                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> Terkirim</span>
                                        <% } else if (row.status === 'disimpan') { %>
                                            <span class="badge badge-secondary px-2 py-1"><i class="fas fa-save mr-1"></i> Disimpan</span>
                                        <% } else { %>
                                            <span class="badge badge-warning px-2 py-1"><%= row.status %></span>
                                        <% } %>
                                    </td>
                                    <td class="text-center align-middle">
                                        <a href="/broadcast/show/<%= row.kode %>"
                                            class="btn btn-sm btn-info" title="Detail"><i
                                                class="fa fa-eye"></i></a>
                                        <a href="/broadcast/edit/<%= row.kode %>"
                                            class="btn btn-sm btn-success" title="Edit"><i
                                                class="fa fa-wrench"></i></a>
                                        <a href="/broadcast/<%= row.kode %>/hapus"
                                            onclick="return confirm('Apakah Anda yakin ingin menghapus data broadcast ini?')"
                                            class="btn btn-sm btn-danger" title="Hapus"><i
                                                class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                <% number++; %>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
                <a href="/broadcast" class="btn btn-secondary mt-2"><i class="fas fa-arrow-left mr-1"></i> Kembali ke Semua Broadcast</a>
            </div>
        </div>
    </div>

</div>
<%- include('../templates/f_broadcast'); %>