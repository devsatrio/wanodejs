<%- include('../templates/h'); %>
    <%- include('../templates/n'); %>
        <div class="container-fluid">
            <!-- Alert Flash Messages -->
            <%if (messages.info) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle mr-1"></i> <%= messages.info %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            <%if (messages.infoerror) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle mr-1"></i> <%= messages.infoerror %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>

            <!-- Welcome Banner -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card bg-gradient-primary text-white shadow py-3 px-4 border-0" style="border-radius: 12px;">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h2 class="font-weight-bold mb-1">
                                    <i class="fab fa-whatsapp mr-2"></i>Wa Broadcast Dashboard
                                </h2>
                                <p class="mb-0 text-white-50" style="font-size: 15px;">
                                    Selamat datang kembali, <strong><%= user %></strong> (<span class="badge badge-light text-primary font-weight-bold"><%= level %></span>). Pantau analitik pengiriman dan kelola kampanye broadcast Anda dengan mudah.
                                </p>
                            </div>
                            <div class="col-md-4 text-md-right mt-3 mt-md-0">
                                <% if (level === 'Super Admin') { %>
                                    <a href="/device" class="btn btn-light text-primary font-weight-bold shadow-sm mr-1 mb-1">
                                        <i class="fas fa-qrcode text-success mr-1"></i> Hubungkan
                                    </a>
                                <% } %>
                                <a href="/broadcast/add" class="btn btn-success font-weight-bold shadow-sm mb-1">
                                    <i class="fas fa-paper-plane mr-1"></i> Kirim Broadcast
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4 Metric Cards Row -->
            <div class="row">
                <!-- Total Broadcast -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Total Broadcast</div>
                                    <div class="h4 mb-0 font-weight-bold text-gray-800" id="broadcast">-</div>
                                </div>
                                <div class="col-auto">
                                    <div class="p-2 bg-light rounded-circle text-primary">
                                        <i class="fas fa-envelope fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Contact -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        Jumlah Contact</div>
                                    <div class="h4 mb-0 font-weight-bold text-gray-800" id="contact">-</div>
                                </div>
                                <div class="col-auto">
                                    <div class="p-2 bg-light rounded-circle text-success">
                                        <i class="fas fa-address-book fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Admin/Users -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        Jumlah Admin / User
                                    </div>
                                    <div class="h4 mb-0 font-weight-bold text-gray-800" id="jumlahadmin">-</div>
                                </div>
                                <div class="col-auto">
                                    <div class="p-2 bg-light rounded-circle text-info">
                                        <i class="fas fa-user-shield fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending Broadcast -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        Pending / Antrean Broadcast</div>
                                    <div class="h4 mb-0 font-weight-bold text-gray-800" id="pendingbroadcast">-</div>
                                </div>
                                <div class="col-auto">
                                    <div class="p-2 bg-light rounded-circle text-warning">
                                        <i class="fas fa-clock fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Row -->
            <div class="row">
                <!-- Kolom Kiri: Status Koneksi WA & Fitur Utama -->
                <div class="col-lg-8 mb-4">
                    <!-- Status WhatsApp Connection Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex flex-wrap align-items-center justify-content-between bg-white border-bottom">
                            <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                                <i class="fas fa-plug fa-lg mr-2 text-success"></i> 
                                Status Engine Pengiriman
                            </h6>
                            <span id="waStatusBadge" class="badge badge-secondary px-2 py-1 font-weight-bold">
                                <i class="fas fa-spinner fa-spin mr-1"></i> Memeriksa status...
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-secondary py-3 px-3 font-weight-bold mb-3 d-flex align-items-center justify-content-between flex-wrap" id="statusAlertText">
                                <span><i class="fas fa-spinner fa-spin mr-2"></i> Menghubungkan ke server engine...</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between flex-wrap pt-2">
                                <p class="text-muted small mb-2 mb-md-0" style="max-width: 65%;">
                                    <% if (level === 'Super Admin') { %>
                                        Untuk menghubungkan nomor pengirim, scan QR code, atau mengganti nomor, silakan kunjungi menu Hubungkan.
                                    <% } else { %>
                                        Status koneksi engine pengiriman WhatsApp. Pengaturan nomor dan scan QR dikelola oleh Super Admin.
                                    <% } %>
                                </p>
                                <div>
                                    <% if (level === 'Super Admin') { %>
                                        <a href="/device" class="btn btn-success font-weight-bold shadow-sm mr-1">
                                            <i class="fas fa-qrcode mr-1"></i> Hubungkan Perangkat
                                        </a>
                                    <% } else { %>
                                        <span class="badge badge-light text-muted p-2 font-weight-normal border">
                                            <i class="fas fa-shield-alt mr-1 text-success"></i> Dikelola Super Admin
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shortcut / Fitur Utama -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 bg-white border-bottom">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-th-large mr-2 text-primary"></i>
                                Menu Cepat &amp; Fitur Utama
                            </h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="<%= (level === 'Super Admin') ? 'col-md-4' : 'col-md-6' %> mb-3">
                                    <div class="border rounded p-3 h-100 bg-light text-center transition-hover">
                                        <div class="text-success mb-2">
                                            <i class="fas fa-paper-plane fa-2x"></i>
                                        </div>
                                        <h6 class="font-weight-bold text-dark mb-1">Kirim Broadcast</h6>
                                        <p class="text-muted small mb-2">Kirim pesan massal dengan filter kontak, jeda acak, dan simulasi mengetik.</p>
                                        <a href="/broadcast/add" class="btn btn-sm btn-outline-success font-weight-bold btn-block">Buat Pesan</a>
                                    </div>
                                </div>
                                <div class="<%= (level === 'Super Admin') ? 'col-md-4' : 'col-md-6' %> mb-3">
                                    <div class="border rounded p-3 h-100 bg-light text-center transition-hover">
                                        <div class="text-primary mb-2">
                                            <i class="fas fa-address-book fa-2x"></i>
                                        </div>
                                        <h6 class="font-weight-bold text-dark mb-1">Database Kontak</h6>
                                        <p class="text-muted small mb-2">Kelola kontak, import dari Excel/CSV, dan export kontak langsung ke format VCF.</p>
                                        <a href="/contact" class="btn btn-sm btn-outline-primary font-weight-bold btn-block">Kelola Kontak</a>
                                    </div>
                                </div>
                                <% if (level === 'Super Admin') { %>
                                    <div class="col-md-4 mb-3">
                                        <div class="border rounded p-3 h-100 bg-light text-center transition-hover">
                                            <div class="text-info mb-2">
                                                <i class="fas fa-qrcode fa-2x"></i>
                                            </div>
                                            <h6 class="font-weight-bold text-dark mb-1">Hubungkan</h6>
                                            <p class="text-muted small mb-2">Scan QR Code, ganti nomor pengirim, dan pantau kesehatan sesi penautan.</p>
                                            <a href="/device" class="btn btn-sm btn-outline-info font-weight-bold btn-block">Hubungkan</a>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Kolom Kanan: Info Engine & Tips Anti-Banned -->
                <div class="col-lg-4 mb-4">
                    <!-- Ringkasan Engine & Keamanan -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 bg-white border-bottom">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-shield-alt mr-2 text-success"></i>
                                Proteksi &amp; Sistem Engine
                            </h6>
                        </div>
                        <div class="card-body p-3">
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="text-muted"><i class="fas fa-keyboard text-success mr-2"></i>Simulasi Mengetik:</span>
                                    <span class="badge badge-success px-2 py-1">Aktif</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="text-muted"><i class="fas fa-stopwatch text-info mr-2"></i>Jeda Dinamis (Delay):</span>
                                    <span class="badge badge-info px-2 py-1">3 - 8 Detik</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="text-muted"><i class="fas fa-lock text-warning mr-2"></i>Keamanan Login:</span>
                                    <span class="badge badge-warning text-dark px-2 py-1">SVG Captcha + Bcrypt</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="text-muted"><i class="fas fa-database text-primary mr-2"></i>Database Local:</span>
                                    <span class="badge badge-primary px-2 py-1">MySQL Local</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="text-muted"><i class="fas fa-bolt text-danger mr-2"></i>Socket Engine:</span>
                                    <span class="badge badge-danger px-2 py-1">Real-time IO</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Petunjuk Singkat -->
                    <div class="card shadow mb-4 border-left-success">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start">
                                <div class="mr-3 text-success mt-1">
                                    <i class="fas fa-lightbulb fa-2x"></i>
                                </div>
                                <div>
                                    <h6 class="font-weight-bold text-dark mb-1">Tips Efektivitas Broadcast</h6>
                                    <p class="text-muted small mb-0">
                                        Pastikan data nomor penerima valid (format diawali dengan 62 atau 08). Anda dapat mengimpor data kontak dari Excel atau mengekspornya ke format <code>.vcf</code> kapan saja.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../templates/f_dashboard'); %>
