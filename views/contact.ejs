<%- include('../templates/h'); %>
<%- include('../templates/n'); %>
<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">Contact</h1>
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">List Data Contact</h6>
            <div class="d-flex flex-wrap align-items-center justify-content-end">
                <form class="form-inline" action="/contact/search" method="GET">
                    <div class="form-group mr-2 mb-2">
                      <label class="sr-only">Cari</label>
                      <input type="text" class="form-control" placeholder="No. RM / Nama" name="search" required>
                    </div>
                    <button type="submit" class="btn btn-primary mb-2"><i class="fas fa-search"></i> Cari</button>
                </form>
                <button type="button" class="btn btn-outline-primary mb-2 ml-2" onclick="openExportVcfModal()" title="Validasi dan unduh kontak format VCF untuk HP">
                    <i class="fas fa-file-export mr-1"></i> Export VCF (HP)
                </button>
                <button type="button" class="btn btn-outline-info mb-2 ml-2" data-toggle="modal" data-target="#importContactModal" title="Import kontak dari Excel, CSV, VCF, atau teks">
                    <i class="fas fa-file-import mr-1"></i> Import Kontak
                </button>
                <a href="/contact/add" class="ml-2 mb-2">
                    <button type="button" class="btn btn-success"><i class="fas fa-plus mr-1"></i> Tambah</button>
                </a>
            </div>
        </div>
        <div class="card-body">
            <% if (messages.info) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> <%= messages.info %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            <% if (messages.infoerror) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> <%= messages.infoerror %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            <% 
                var currentOffset = (typeof offset !== 'undefined') ? offset : 0;
                var listContact = (typeof products !== 'undefined' && products) ? products : [];
                var totalData = (typeof total_data !== 'undefined') ? total_data : listContact.length;
                var totalPages = (typeof total_pages !== 'undefined') ? total_pages : 1;
                var pageNumber = (typeof page_number !== 'undefined') ? page_number : 1;
            %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTableContact" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">No</th>
                            <th>Nama</th>
                            <th style="width: 150px;">No. Telp</th>
                            <th style="width: 120px;">No. RM</th>
                            <th>Keterangan</th>
                            <th style="width: 130px;" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!listContact || listContact.length === 0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-address-book fa-2x mb-2 d-block text-gray-400"></i>
                                    Belum ada data kontak.
                                </td>
                            </tr>
                        <% } else { %>
                            <% var number = currentOffset + 1; %>
                            <% listContact.forEach(function(row) { %>
                                <tr>
                                    <td class="text-center align-middle"><%= number %></td>
                                    <td class="align-middle font-weight-bold"><%= row.nama %></td>
                                    <td class="align-middle"><%= row.telp %></td>
                                    <td class="align-middle"><%= row.no_rm || '-' %></td>
                                    <td class="align-middle"><%= row.deskripsi || '-' %></td>
                                    <td class="text-center align-middle">
                                        <a href="/contact/<%= row.id %>/edit" class="btn btn-sm btn-success" title="Edit"><i class="fa fa-wrench"></i></a>
                                        <a href="/contact/<%= row.id %>/hapus" onclick="return confirm('Apakah Anda yakin ingin menghapus data kontak ini?')" class="btn btn-sm btn-danger" title="Hapus"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                <% number++; %>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Section -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top">
                <div class="text-muted small mb-2 mb-md-0">
                    Menampilkan <strong><%= listContact.length > 0 ? currentOffset + 1 : 0 %></strong> - <strong><%= Math.min(currentOffset + listContact.length, totalData) %></strong> dari <strong><%= totalData %></strong> data kontak
                    <% if (totalPages > 1) { %>
                        (Halaman <strong><%= pageNumber %></strong> dari <strong><%= totalPages %></strong>)
                    <% } %>
                </div>

                <% if (totalPages > 1) { %>
                    <nav aria-label="Contact Page Navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- First -->
                            <li class="page-item <%= pageNumber <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/contact?page=1" title="Halaman Pertama">
                                    <i class="fas fa-angle-double-left"></i>
                                </a>
                            </li>

                            <!-- Prev -->
                            <li class="page-item <%= pageNumber <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/contact?page=<%= pageNumber - 1 %>" title="Sebelumnya">
                                    <i class="fas fa-angle-left"></i>
                                </a>
                            </li>

                            <!-- Numbered Pages with Ellipsis -->
                            <% 
                                var startPage = Math.max(1, pageNumber - 2);
                                var endPage = Math.min(totalPages, pageNumber + 2);

                                if (startPage > 1) { %>
                                    <li class="page-item"><a class="page-link" href="/contact?page=1">1</a></li>
                                    <% if (startPage > 2) { %>
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <% } %>
                                <% } %>

                            <% for (var i = startPage; i <= endPage; i++) { %>
                                <li class="page-item <%= pageNumber === i ? 'active' : '' %>">
                                    <a class="page-link" href="/contact?page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>

                            <% if (endPage < totalPages) { %>
                                <% if (endPage < totalPages - 1) { %>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                <% } %>
                                <li class="page-item"><a class="page-link" href="/contact?page=<%= totalPages %>"><%= totalPages %></a></li>
                            <% } %>

                            <!-- Next -->
                            <li class="page-item <%= pageNumber >= totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/contact?page=<%= pageNumber + 1 %>" title="Selanjutnya">
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            </li>

                            <!-- Last -->
                            <li class="page-item <%= pageNumber >= totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/contact?page=<%= totalPages %>" title="Halaman Terakhir">
                                    <i class="fas fa-angle-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
    </div>

</div>

<!-- Modal Import Contact -->
<div class="modal fade" id="importContactModal" tabindex="-1" role="dialog" aria-labelledby="importContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold" id="importContactModalLabel">
                    <i class="fas fa-file-import mr-2"></i> Import Data Kontak
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/contact/import" method="POST" enctype="multipart/form-data" id="formImportContact">
                <div class="modal-body">
                    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active font-weight-bold" id="pills-file-tab" data-toggle="pill" href="#pills-file" role="tab" aria-controls="pills-file" aria-selected="true">
                                <i class="fas fa-file-excel mr-1"></i> Upload File (Excel / CSV / VCF)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" id="pills-manual-tab" data-toggle="pill" href="#pills-manual" role="tab" aria-controls="pills-manual" aria-selected="false">
                                <i class="fas fa-keyboard mr-1"></i> Input / Paste Teks Masal
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content" id="pills-tabContent">
                        <!-- Tab 1: Upload File -->
                        <div class="tab-pane fade show active" id="pills-file" role="tabpanel" aria-labelledby="pills-file-tab">
                            <div class="form-group">
                                <label class="font-weight-bold">Pilih File Kontak (.xlsx, .xls, .csv, .vcf):</label>
                                <input type="file" name="file" class="form-control-file border p-2 rounded bg-light" accept=".xlsx, .xls, .csv, .vcf">
                                <small class="form-text text-muted mt-2">
                                    Mendukung file Excel (<code>.xlsx</code> / <code>.xls</code>), CSV, atau file vCard (<code>.vcf</code>).
                                </small>
                            </div>
                            <div class="alert alert-info py-2 px-3 small mb-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-info-circle mr-1"></i> <strong>Format Kolom Excel/CSV:</strong> <code>Nama</code>, <code>No. Telp</code>, <code>No. RM</code>, <code>Keterangan</code>
                                    </div>
                                    <a href="/contact/template-import" class="btn btn-sm btn-success font-weight-bold">
                                        <i class="fas fa-download mr-1"></i> Unduh Template Excel
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Manual Text -->
                        <div class="tab-pane fade" id="pills-manual" role="tabpanel" aria-labelledby="pills-manual-tab">
                            <div class="form-group mb-1">
                                <label class="font-weight-bold">Paste Data Kontak (1 baris per kontak):</label>
                                <textarea name="manual_text" class="form-control font-monospace" rows="6" placeholder="Contoh format (pisahkan koma):&#10;Budi Santoso, 081234567890, 001234, Pasien Umum&#10;Siti Rahma, 085712345678, 001235, Pasien BPJS"></textarea>
                            </div>
                            <small class="text-muted">Format tiap baris: <code>Nama, Nomor HP, No. RM (opsional), Keterangan (opsional)</code></small>
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="skip_duplicate" name="skip_duplicate" value="1" checked>
                        <label class="custom-control-label font-weight-bold text-dark" for="skip_duplicate">
                            <i class="fas fa-shield-alt text-success mr-1"></i> Lewati nomor telepon yang sudah ada (Cegah Duplikat)
                        </label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary font-weight-bold" id="btnSubmitImport">
                        <i class="fas fa-cloud-upload-alt mr-1"></i> Mulai Import Kontak
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Validasi & Export VCF -->
<div class="modal fade" id="exportVcfModal" tabindex="-1" role="dialog" aria-labelledby="exportVcfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title font-weight-bold" id="exportVcfModalLabel">
                    <i class="fas fa-file-export mr-2"></i> Validasi &amp; Export Kontak VCF (Smartphone)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <!-- Loading State -->
                <div id="vcfValidationLoading" class="text-center py-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary mb-3"></i>
                    <h6 class="font-weight-bold text-dark mb-1">Memeriksa Validitas Nomor Kontak...</h6>
                    <p class="text-muted small mb-0">Sistem sedang memverifikasi format nomor dan nama agar tidak gagal saat diimpor di HP.</p>
                </div>

                <!-- Result Container -->
                <div id="vcfValidationContent" style="display: none;">
                    <div class="row mb-3">
                        <div class="col-md-4 mb-2">
                            <div class="card border-left-primary shadow-sm h-100 py-2">
                                <div class="card-body py-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kontak</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="vcfTotalCount">0</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="card border-left-success shadow-sm h-100 py-2">
                                <div class="card-body py-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Siap Ekspor (Valid)</div>
                                    <div class="h5 mb-0 font-weight-bold text-success" id="vcfValidCount">0</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="card border-left-danger shadow-sm h-100 py-2">
                                <div class="card-body py-2">
                                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Perlu Diperbaiki</div>
                                    <div class="h5 mb-0 font-weight-bold text-danger" id="vcfInvalidCount">0</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alert Info / Warning -->
                    <div id="vcfStatusAlert" class="alert py-3 px-3 mb-3 font-weight-bold"></div>

                    <!-- Invalid List Accordion/Table (if any) -->
                    <div id="vcfInvalidSection" style="display: none;" class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="font-weight-bold text-danger small">
                                <i class="fas fa-exclamation-circle mr-1"></i> Rincian Kontak yang Tidak Valid:
                            </span>
                            <button class="btn btn-xs btn-outline-danger py-0 px-2" type="button" data-toggle="collapse" data-target="#vcfInvalidListCollapse">
                                Lihat / Sembunyikan Rincian
                            </button>
                        </div>
                        <div class="collapse show" id="vcfInvalidListCollapse">
                            <div class="table-responsive border rounded" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm table-striped table-hover mb-0" style="font-size: 13px;">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Nama</th>
                                            <th>No. Telp</th>
                                            <th>No. RM</th>
                                            <th>Keterangan Masalah</th>
                                            <th class="text-center">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="vcfInvalidTbody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Pilihan Filter Ekspor -->
                    <div class="card bg-light border p-3">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="vcfOnlyValidCheckbox" checked onchange="toggleVcfExportOption()">
                            <label class="custom-control-label font-weight-bold text-dark" for="vcfOnlyValidCheckbox">
                                <i class="fas fa-check-circle text-success mr-1"></i> Hanya ekspor kontak yang VALID (Dianjurkan)
                            </label>
                        </div>
                        <small class="text-muted ml-4 mt-1">
                            Memfilter nomor yang kosong / rusak agar file <code>.vcf</code> dapat di-import 100% lancar di aplikasi Kontak HP (Android / iOS).
                        </small>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>
                <a href="/contact/export-vcf?only_valid=1" id="btnDownloadVcf" class="btn btn-success font-weight-bold shadow-sm">
                    <i class="fas fa-download mr-1"></i> Download File VCF (.vcf)
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openExportVcfModal() {
        $('#exportVcfModal').modal('show');
        $('#vcfValidationLoading').show();
        $('#vcfValidationContent').hide();
        $('#btnDownloadVcf').addClass('disabled').attr('disabled', 'disabled');

        $.ajax({
            type: 'GET',
            url: '/contact/validate-vcf',
            success: function(data) {
                $('#vcfValidationLoading').hide();
                $('#vcfValidationContent').fadeIn();

                var total = data.total || 0;
                var valid = data.validCount || 0;
                var invalid = data.invalidCount || 0;

                $('#vcfTotalCount').text(total);
                $('#vcfValidCount').text(valid);
                $('#vcfInvalidCount').text(invalid);

                if (total === 0) {
                    $('#vcfStatusAlert').removeClass('alert-success alert-warning').addClass('alert-danger')
                        .html('<i class="fas fa-exclamation-triangle mr-2"></i> Belum ada data kontak di database untuk diekspor.');
                    $('#btnDownloadVcf').addClass('disabled').attr('disabled', 'disabled');
                    $('#vcfInvalidSection').hide();
                    return;
                }

                if (invalid === 0) {
                    $('#vcfStatusAlert').removeClass('alert-warning alert-danger').addClass('alert-success')
                        .html('<i class="fas fa-check-circle mr-2"></i> <strong>Semua data valid!</strong> Seluruh ' + total + ' kontak memiliki nomor yang valid dan siap diimpor ke HP tanpa kendala.');
                    $('#vcfInvalidSection').hide();
                } else {
                    $('#vcfStatusAlert').removeClass('alert-success alert-danger').addClass('alert-warning')
                        .html('<i class="fas fa-exclamation-triangle mr-2"></i> Ditemukan <strong>' + invalid + ' kontak</strong> dengan format nomor tidak valid / terlalu pendek. Dianjurkan hanya mengekspor <strong>' + valid + ' kontak valid</strong> agar proses import di HP tidak gagal.');
                    $('#vcfInvalidSection').show();

                    var rowsHtml = '';
                    (data.invalidList || []).forEach(function(item) {
                        rowsHtml += '<tr>' +
                            '<td class="font-weight-bold">' + (item.nama || '-') + '</td>' +
                            '<td><code>' + (item.telp || '-') + '</code></td>' +
                            '<td>' + (item.no_rm || '-') + '</td>' +
                            '<td class="text-danger font-weight-bold"><i class="fas fa-times-circle mr-1"></i> ' + item.reason + '</td>' +
                            '<td class="text-center"><a href="/contact/' + item.id + '/edit" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit Kontak"><i class="fas fa-edit"></i> Edit</a></td>' +
                            '</tr>';
                    });
                    $('#vcfInvalidTbody').html(rowsHtml);
                }

                $('#btnDownloadVcf').removeClass('disabled').removeAttr('disabled');
                toggleVcfExportOption();
            },
            error: function(xhr) {
                $('#vcfValidationLoading').hide();
                $('#vcfValidationContent').fadeIn();
                $('#vcfStatusAlert').removeClass('alert-success alert-warning').addClass('alert-danger')
                    .html('<i class="fas fa-times-circle mr-2"></i> Gagal memvalidasi kontak: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Terjadi kesalahan sistem'));
            }
        });
    }

    function toggleVcfExportOption() {
        var onlyValid = $('#vcfOnlyValidCheckbox').is(':checked');
        var exportUrl = '/contact/export-vcf?only_valid=' + (onlyValid ? '1' : '0');
        $('#btnDownloadVcf').attr('href', exportUrl);
    }

    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('formImportContact');
        if (form) {
            form.addEventListener('submit', function() {
                var btn = document.getElementById('btnSubmitImport');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Sedang Memproses Import...';
                }
            });
        }
    });
</script>
<%- include('../templates/f'); %>